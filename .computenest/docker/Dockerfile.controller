# ComputeNest build wrapper for the upstream controller image.
# Source and base images are pinned for reproducible builds.
ARG OCE_COMMIT=a5cc0d75139f2c61dd148f8332a9167102fd9752
ARG NODE_BASE_IMAGE=public.ecr.aws/docker/library/node:24-bookworm@sha256:64af3819f9275802414d7cdc38c27e9d82bd564dec4d4da87d008255d36c63b4
ARG NODE_RUNTIME_BASE_IMAGE=public.ecr.aws/docker/library/node:24-bookworm-slim@sha256:0e0ff40c39bc087845bfb27465a0df4ea419520094bc35842ff83dd8cbe6f9b6

FROM ${NODE_BASE_IMAGE} AS source
ARG OCE_COMMIT
WORKDIR /source
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && curl --fail --location --silent --show-error \
      "https://codeload.github.com/openclaw/openclaw-enterprise/tar.gz/${OCE_COMMIT}" \
      -o /tmp/source.tar.gz \
    && tar -xzf /tmp/source.tar.gz --strip-components=1 \
    && rm /tmp/source.tar.gz

FROM ${NODE_BASE_IMAGE} AS dependencies
WORKDIR /app
RUN node -e "if (Number(process.versions.node.split('.')[0]) !== 24) throw new Error('Node.js 24 is required')"
COPY --from=source /source/LICENSE /source/package.json /source/pnpm-lock.yaml /source/pnpm-workspace.yaml ./
COPY --from=source /source/apps/controller/package.json apps/controller/package.json
COPY --from=source /source/packages/audit/package.json packages/audit/package.json
COPY --from=source /source/packages/contracts/package.json packages/contracts/package.json
COPY --from=source /source/packages/iam/package.json packages/iam/package.json
COPY --from=source /source/packages/occ/package.json packages/occ/package.json
COPY --from=source /source/packages/utils/package.json packages/utils/package.json
RUN corepack pnpm install --frozen-lockfile --prod --ignore-scripts

FROM dependencies AS console-build
ARG OCE_COMMIT
COPY --from=source /source/apps/controller/src/console/index.html apps/controller/src/console/index.html
COPY --from=source /source/scripts/build-console-metadata.mjs scripts/build-console-metadata.mjs
RUN node scripts/build-console-metadata.mjs "$OCE_COMMIT"

FROM ${NODE_RUNTIME_BASE_IMAGE} AS runtime
ARG OCE_COMMIT
ENV NODE_ENV=production
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates openssl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=dependencies --chown=node:node /app/ ./
COPY --from=source --chown=node:node /source/package.json /source/pnpm-workspace.yaml ./
COPY --from=source --chown=node:node /source/packages/audit/package.json packages/audit/package.json
COPY --from=source --chown=node:node /source/packages/audit/src packages/audit/src
COPY --from=source --chown=node:node /source/packages/contracts/package.json packages/contracts/package.json
COPY --from=source --chown=node:node /source/packages/contracts/src packages/contracts/src
COPY --from=source --chown=node:node /source/packages/iam/package.json packages/iam/package.json
COPY --from=source --chown=node:node /source/packages/iam/src packages/iam/src
COPY --from=source --chown=node:node /source/packages/occ/package.json packages/occ/package.json
COPY --from=source --chown=node:node /source/packages/occ/src packages/occ/src
COPY --from=source --chown=node:node /source/packages/utils/package.json packages/utils/package.json
COPY --from=source --chown=node:node /source/packages/utils/src packages/utils/src
COPY --from=source --chown=node:node /source/apps/controller/src apps/controller/src
COPY --from=console-build --chown=node:node /app/apps/controller/src/console/index.html apps/controller/src/console/index.html
COPY --from=source --chown=node:node /source/migrations/[0-9]*.sql migrations/
COPY --from=source --chown=node:node /source/migrations/meta/_journal.json /source/migrations/meta/canonical-history.json migrations/meta/
COPY --from=source --chown=node:node /source/scripts/migrate-production.mjs /source/scripts/migration-history.mjs /source/scripts/migration-catalog.mjs /source/scripts/bootstrap-installation.mjs /source/scripts/auth-maintain.mjs /source/scripts/production-healthcheck.mjs scripts/
COPY --from=source --chown=node:node /source/scripts/lib/auth-maintain-arguments.mjs scripts/lib/auth-maintain-arguments.mjs
COPY --from=source --chown=node:node /source/deploy/presets deploy/presets
COPY --chown=node:node .computenest/docker/platform-operator.mjs /opt/oce/computenest/platform-operator.mjs
COPY --chown=node:node .computenest/docker/tls-proxy.mjs /opt/oce/computenest/tls-proxy.mjs
LABEL org.opencontainers.image.source="https://github.com/openclaw/openclaw-enterprise"
LABEL org.opencontainers.image.revision=${OCE_COMMIT}
USER node
ENTRYPOINT ["node"]
CMD ["apps/controller/src/server.mjs"]
