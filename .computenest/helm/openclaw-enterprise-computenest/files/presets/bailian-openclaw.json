{
  "name": "阿里云百炼 OpenClaw",
  "template": {
    "variables": {
      "name": {
        "type": "string",
        "description": "Agent 名称"
      },
      "model": {
        "type": "string",
        "default": "qwen-plus",
        "description": "阿里云百炼模型 ID，例如 qwen-plus、qwen-max、qwen-flash"
      },
      "modelSecret": {
        "type": "password",
        "description": "阿里云百炼 API Key（sk- 开头），创建 Agent 时会保存为 Secret"
      }
    },
    "agent": {
      "name": "{{ vars.name }}",
      "executionMode": "embedded",
      "backendId": null,
      "harnessAuth": {
        "method": "api_key",
        "secret": "{{ vars.modelSecret }}"
      },
      "plugins": {}
    },
    "configuration": {
      "values": {
        "gateway": {
          "mode": "local",
          "bind": "lan",
          "controlUi": {
            "enabled": true
          },
          "auth": {
            "password": {
              "source": "env",
              "provider": "default",
              "id": "OPENCLAW_GATEWAY_PASSWORD"
            }
          },
          "http": {
            "endpoints": {
              "chatCompletions": {
                "enabled": true
              }
            }
          }
        },
        "agents": {
          "defaults": {
            "model": "openai/{{ vars.model }}",
            "models": {
              "openai/{{ vars.model }}": {
                "agentRuntime": {
                  "id": "openclaw"
                }
              }
            }
          }
        },
        "models": {
          "providers": {
            "openai": {
              "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
              "api": "openai-completions",
              "models": [
                {
                  "id": "{{ vars.model }}",
                  "name": "{{ vars.model }}",
                  "contextWindow": 131072,
                  "maxTokens": 8192,
                  "reasoning": false,
                  "cost": {
                    "input": 0,
                    "output": 0,
                    "cacheRead": 0,
                    "cacheWrite": 0
                  }
                }
              ]
            }
          }
        },
        "memory": {
          "search": {
            "provider": "openai",
            "model": "text-embedding-v3"
          }
        },
        "browser": {
          "enabled": false
        },
        "tools": {
          "elevated": {
            "enabled": false
          },
          "web": {
            "search": {
              "enabled": false
            },
            "fetch": {
              "enabled": true
            }
          }
        }
      },
      "secretBindings": {}
    }
  }
}
